{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../",
    "baseUrl": "../",
    "paths": {
      "*": ["../node_modules/*", "../src/*"]
    },
    "forceConsistentCasingInFileNames": false,
    "skipLibCheck": true
  },
  "include": [
    "./**/*.ts",
    "../src/**/*.ts"
  ],
  "exclude": [
    "../node_modules"
  ]
}
