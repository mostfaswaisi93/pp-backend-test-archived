                    </div>
                </div>
                <div style="display: flex; line-height: 20px; width: 50%">
                    <div style="width: 50%;">Payroll Frequency:</div>
                    <div style="width: 50%; font-weight: 500;">  <%- user?.salesReport[0]?.payrollFrequency%></div>
                </div>
            </div>
            <div style="width: 3%;"></div>
        </div>
    </div>
