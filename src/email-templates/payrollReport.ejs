<!DOCTYPE html>
<html lang="en">

<%
 formatTime = function(time){
    let hr = Math.floor(time / 3600)
    let min = Math.floor((time%3600) / 60)
    return (hr > 9 ? hr : '0' + hr) + ":" + (min > 9 ? min : '0' + min) 
  }
%>
