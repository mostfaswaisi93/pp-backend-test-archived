        border: 1px solid #EAEAEA66;
    }
    .table thead tr th {
       border-width: 1px;
    }
    .table tbody tr td {
       border-width: 1px;
    }
    .theading {
        font-size: 10px;
        font-weight: 600;
        line-height: 20px;
        letter-spacing: 0px;
        text-align: left;
        padding: 10px 10px 10px 0px;

    }
    .timeActivWrp {
    width: 100%;
    display: block;
    margin-bottom: 30px;
}
h2.timeHeading {
    margin-top: 0;
}

h2.timeHeading {
    width: 100%;
    font-weight: 500;
    font-size: 16px;
    line-height: 150%;
    color: #000000;
    margin-bottom: 10px;
}
.earnLltBody {
    width: 100%;
    background: #F0F3F4;
    border-radius: 3px;
}

.earnLltBody ul {
    padding: 8px 0;
    margin: 0;
    width: 80%;
    display: flex;
    height: 100%;
    display: -webkit-flex;
    display: -moz-flex;
    display: -ms-flex;
    display: -o-flex;
    justify-content: inherit;
    align-items: center;
}
.earnLltBody .otherIncome {
  padding: 8px 0;
  margin: 0;
  width: 80%;
  display: flex;
  height: 100%;
  display: -webkit-flex;
  display: -moz-flex;
  display: -ms-flex;
  display: -o-flex;
  justify-content: inherit;
  align-items: center;
}

.earnLltBody .item {
    list-style: none;
    padding: 0 20px;
    font-size: 14px;
    line-height: 150%;
    color: #303135;
}
.earnLltBody ul li  {
    list-style: none;
    padding: 0 20px;
    font-size: 14px;
    line-height: 150%;
    color: #303135;
    font-weight: 500;
}

.earnLltBody .otherIncome div{
  padding: 0 10px;
}

.earnLltBody ul li span {
    margin-right: 10px;
    font-weight: 500;
}

.earnLltBody .otherIncome div span {
  margin-right: 10px;
  font-weight: 500;
}


</style>

