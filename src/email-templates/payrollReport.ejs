<style>
    * {
        font-size: 10px;
    }
    body {
        margin-left: 10%;
        margin-right: 10%;
        margin-top: 30px;
    }
    .staffDetails {
        top: 90px;
        left: 16px;
        padding: 10px;
        border-radius: 3px;
        border: 1px;
        gap: 5px;
        background: linear-gradient(0deg, rgba(234, 234, 234, 0.4), rgba(234, 234, 234, 0.4)),
