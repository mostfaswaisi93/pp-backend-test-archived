    <div>
        <table class="table" style="border: 1px solid #EAEAEA; border-radius: 3px;">
            <thead>
                <tr style="border-width: 1px;">
                    <th >Staff Name</th>
                    <th >Staff ID</th>
                    <th >Earning Report ID</th>
                    <th >Salary</th>
                    <th >Commissions</th>
                    <th >Total Earnings</th>
                    <th >Reimbursable Expenses </th>
                    <th >Spiff</th>
                    <th >Bonus</th>
                </tr>
            </thead>
            <tbody>
                <% for(var i=0; i < user?.salesReport?.length; i++) {%>
                    <tr style="border-width: 1px;">
                        <td><%= user?.staff[i]?.firstName %> <%= user?.staff[i]?.lastName %></td>
                        <td><%= user?.staff[i]?.staffId %></td>
                        <td><%= user?.salesReport[i]?.serId %></td>
                        <td>$<%= parseFloat(user?.salesReport[i]?.salary)?.toFixed(2) %></td>
                        <td>$<%= parseFloat(user?.salesReport[i]?.totalCommission)?.toFixed(2) %></td>
                        <td>$<%= parseFloat(user?.salesReport[i]?.totalEarnings)?.toFixed(2) %></td>
                        <td>$<%= parseFloat(user?.salesReport[i]?.reimbursable)?.toFixed(2) %></td>
                        <td>$<%= parseFloat(user?.salesReport[i]?.spiff)?.toFixed(2) %></td>
                        <td>$<%= parseFloat(user?.salesReport[i]?.bonus)?.toFixed(2) %></td>
                    </tr>
                <% } %>
            </tbody>
        </table>

    </div>
    <div>
